# ===== Agenda Pilates =====
# Sem estas variáveis (ou com NEXT_PUBLIC_DEMO=1) o app roda em MODO DEMONSTRAÇÃO,
# com dados fictícios em memória — ótimo para testar sem configurar nada.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Force o modo demo mesmo com Supabase configurado (1 = demo)
# NEXT_PUBLIC_DEMO=1
