# Copie para .env.local e preencha. Sem nada preenchido (ou com
# NEXT_PUBLIC_DEMO=1) o app roda em modo demonstração, em memória.

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# server-only (NUNCA NEXT_PUBLIC): /api/usuarios (Config → Equipe)
# e registro de uso da IA (tabela uso_ia)
SUPABASE_SERVICE_ROLE_KEY=

# assistente de IA (aba ✨ Assistente) — server-only
ANTHROPIC_API_KEY=
# opcional; default: claude-haiku-4-5 (rápido/barato)
ANTHROPIC_MODEL=claude-haiku-4-5
# teto mensal de gasto com a IA em US$ (default 5); ao atingir, o chat pausa
IA_LIMITE_MENSAL_USD=5

# força o modo demonstração mesmo com Supabase configurado
# NEXT_PUBLIC_DEMO=1
